#!/bin/sh
# Installs the Canva Windows desktop app through Wine (experimental).
# Canva has no Linux version. The installer is downloaded by you from canva.com,
# so nothing from Canva is stored in the WinLite ISO.
export WINEPREFIX="$HOME/.wine-canva"
if [ "$(dpkg --print-architecture)" = amd64 ]; then export WINEARCH=win64; else export WINEARCH=win32; fi
export WINEDEBUG=-all

zenity --question --width=500 --title="Install Canva desktop app" \
  --text="Canva has no Linux app, so this runs the Windows version through Wine.\nThis is experimental: it may be slow or may not start.\nThe Canva website (Microsoft Office-style web shortcut: 'Canva (Web)') always works.\n\nStep 1: your browser will open canva.com/download. Download the Windows installer.\nStep 2: come back, click OK, and choose the downloaded file.\n\nContinue?" || exit 0

xdg-open "https://www.canva.com/download/" >/dev/null 2>&1 &

zenity --info --width=420 --title="Install Canva desktop app" \
  --text="When the Windows installer has finished downloading, click OK and select it."

SETUP=$(zenity --file-selection --title="Select the Canva installer (.exe)" \
  --filename="$HOME/Downloads/" --file-filter="Installer | *.exe *.EXE") || exit 0

(
  echo "# Preparing Windows environment..."
  wineboot -i
  winetricks -q win10 corefonts
) | zenity --progress --pulsate --auto-close --no-cancel --title="Preparing Canva" --width=420

wine start /unix "$SETUP"
