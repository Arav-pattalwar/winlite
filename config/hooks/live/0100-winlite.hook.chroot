#!/bin/sh
# Runs inside the image at build time.
set -e

# --- Windows 11-style Fluent theme + icons (open source) ---
cd /tmp
git clone --depth 1 https://github.com/vinceliuice/Fluent-gtk-theme.git
git clone --depth 1 https://github.com/vinceliuice/Fluent-icon-theme.git
(cd Fluent-gtk-theme && ./install.sh -c light -t default)
(cd Fluent-icon-theme && ./install.sh)
rm -rf /tmp/Fluent-*

# --- Google Chrome (amd64 only; Google ships no i386 build, use Chromium there) ---
if [ "$(dpkg --print-architecture)" = amd64 ]; then
  curl -fsSL -o /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
  apt-get install -y /tmp/chrome.deb
  rm /tmp/chrome.deb
else
  apt-get install -y chromium
fi

# --- Microsoft Office: cannot be bundled (licensed). Provide Office on the web
#     shortcuts and OnlyOffice-compatible LibreOffice for .docx/.xlsx/.pptx. ---
mkdir -p /usr/share/applications
for app in "Word|word" "Excel|excel" "PowerPoint|powerpoint"; do
  name=${app%%|*}; slug=${app##*|}
  cat > /usr/share/applications/office-$slug.desktop <<EOF
[Desktop Entry]
Name=Microsoft $name (Web)
Exec=google-chrome-stable --app=https://www.office.com/launch/$slug
Icon=applications-office
Type=Application
Categories=Office;
EOF
done

# --- Make .exe double-clickable through Wine ---
cat > /usr/share/applications/wine-exe.desktop <<EOF
[Desktop Entry]
Name=Windows Program Loader
Exec=wine start /unix %f
Type=Application
MimeType=application/x-ms-dos-executable;application/x-msi;application/vnd.microsoft.portable-executable;
NoDisplay=true
EOF

# --- Low-resource tuning for 1 core / 4 GB ---
cat > /etc/sysctl.d/99-winlite.conf <<EOF
vm.swappiness=100
vm.vfs_cache_pressure=50
EOF
echo "ALGO=lz4
PERCENT=50" > /etc/default/zramswap

# Disable services a desktop doesn't need; no telemetry, no AI assistant is installed.
systemctl disable bluetooth.service cups.service ModemManager.service 2>/dev/null || true
