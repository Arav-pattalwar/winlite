#!/bin/sh
# Runs inside the image at build time.
set -e

# --- Windows 11-style Fluent theme + icons (open source) ---
cd /tmp
git clone --depth 1 https://github.com/vinceliuice/Fluent-gtk-theme.git
git clone --depth 1 https://github.com/vinceliuice/Fluent-icon-theme.git
(cd Fluent-gtk-theme && ./install.sh -c light -t default)
(cd Fluent-icon-theme && ./install.sh)
rm -rf /tmp/Fluent-*

# --- Browser: Chromium (open source, installed from the package list) ---

# --- 32-bit Windows programs on the 64-bit image: enable i386 and add wine32 ---
if [ "$(dpkg --print-architecture)" = amd64 ]; then
  dpkg --add-architecture i386
  apt-get update
  apt-get install -y wine32:i386 || true

  # --- Newer Wine from the official WineHQ repository (Debian's own Wine is 8.0) ---
  mkdir -p /etc/apt/keyrings
  if curl -fsSL -o /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key \
     && curl -fsSL -o /etc/apt/sources.list.d/winehq-bookworm.sources https://dl.winehq.org/wine-builds/debian/dists/bookworm/winehq-bookworm.sources; then
    apt-get update
    apt-get install -y --install-recommends winehq-stable || true
  fi
  # Make the WineHQ build the default `wine` if it installed.
  if [ -x /opt/wine-stable/bin/wine ]; then
    for b in wine wine64 wineboot winecfg wineserver winepath; do
      [ -x /opt/wine-stable/bin/$b ] && ln -sf /opt/wine-stable/bin/$b /usr/local/bin/$b
    done
  fi
fi

# --- OnlyOffice Desktop Editors (free; best .docx/.xlsx/.pptx fidelity; amd64 only) ---
if [ "$(dpkg --print-architecture)" = amd64 ]; then
  curl -fsSL -o /tmp/onlyoffice.deb https://github.com/ONLYOFFICE/DesktopEditors/releases/latest/download/onlyoffice-desktopeditors_amd64.deb \
    && apt-get install -y /tmp/onlyoffice.deb || true
  rm -f /tmp/onlyoffice.deb
fi

# --- Microsoft Office: cannot be bundled (licensed). Provide Office on the web
#     shortcuts and OnlyOffice-compatible LibreOffice for .docx/.xlsx/.pptx. ---
mkdir -p /usr/share/applications
# One shared browser profile, so signing in once (e.g. with a Microsoft 365 Family
# account) is remembered across Word, Excel, PowerPoint, Outlook and OneDrive.
for app in "Word|https://www.office.com/launch/word" \
           "Excel|https://www.office.com/launch/excel" \
           "PowerPoint|https://www.office.com/launch/powerpoint" \
           "Outlook|https://outlook.office.com/mail/" \
           "OneDrive|https://onedrive.live.com/"; do
  name=${app%%|*}; url=${app#*|}
  cat > "/usr/share/applications/office-$name.desktop" <<EOF
[Desktop Entry]
Name=Microsoft $name (Web)
Exec=sh -c 'chromium --user-data-dir="\$HOME/.config/winlite-office" --app=$url'
Icon=applications-office
Type=Application
Categories=Office;
EOF
done

# --- Make .exe double-clickable through Wine ---
cat > /usr/share/applications/wine-exe.desktop <<EOF
[Desktop Entry]
Name=Windows Program Loader
Exec=wine start /unix %f
Type=Application
MimeType=application/x-ms-dos-executable;application/x-msi;application/vnd.microsoft.portable-executable;
NoDisplay=true
EOF

# --- Low-resource tuning for 1 core / 4 GB ---
cat > /etc/sysctl.d/99-winlite.conf <<EOF
vm.swappiness=100
vm.vfs_cache_pressure=50
EOF
echo "ALGO=lz4
PERCENT=50" > /etc/default/zramswap

# Disable services a desktop doesn't need; no telemetry, no AI assistant is installed.
systemctl disable bluetooth.service cups.service ModemManager.service 2>/dev/null || true
